<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!--
        The analysis view is a separate model that reads payslip lines straight
        from SQL; the company rules defined on hr.payslip do not apply to it.
        Restrict it to the companies the user is allowed to see, mirroring
        payroll.hr_payslip_rule_company.
    -->
    <record id="hr_payslip_report_view_rule_company" model="ir.rule">
        <field name="name">Payslip Analysis: multi-company</field>
        <field name="model_id" ref="model_hr_payslip_report_view" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>
</odoo>
