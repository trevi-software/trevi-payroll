<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.payroll_payslip_dictionary</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="80" />
        <field name="inherit_id" ref="payroll.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='payroll']" position="inside">
                <block title="Default Values">
                    <setting
                        help="How this field is set will affect the calculated value of salaried employees' pay."
                    >
                        <label for="working_days_calculation" />
                        <field name="working_days_calculation" />
                    </setting>
                    <setting
                        help="Maximum possible regular working hours an employee may work during the week."
                    >
                        <label for="weekly_max_regular_hours" />
                        <field name="weekly_max_regular_hours" />
                    </setting>
                    <setting
                        help="Maximum possible working days an employee may work during the month."
                    >
                        <label for="monthly_max_working_days" />
                        <field name="monthly_max_working_days" />
                    </setting>
                    <setting
                        help="In the 'worked_days' dictionary, the code used for maximum possible working days."
                    >
                        <label for="work_days_code_max" />
                        <field name="work_days_code_max" />
                    </setting>
                </block>
                <block title="Worked Days Codes">
                    <setting
                        help="In the 'worked_days' dictionary, the code used for maximum possible working days."
                    >
                        <label for="work_days_code_max" />
                        <field name="work_days_code_max" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
