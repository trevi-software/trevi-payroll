<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Odoo 19 merged hr.contract into hr: contract data is edited from the
         employee form, which inherits hr.version non-stored fields. -->
    <record id="hr_version_view_form" model="ir.ui.view">
        <field name="name">hr.version.view.form.inherit.payroll_salary_code</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='payroll_information']//div[@name='wage']"
                position="after"
            >
                <field name="payroll_salary_code" groups="hr.group_hr_manager" />
            </xpath>
        </field>
    </record>
</odoo>
